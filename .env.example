# Base Application URL (Production vs Local)
# Production Default: https://app.internationalmentorship.net
# Local Default: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://app.internationalmentorship.net

# API Base Path (Relative or Absolute)
NEXT_PUBLIC_API_BASE_URL=/api

# Allowed CORS Origins (Comma Separated)
ALLOWED_ORIGIN=https://internationalmentorship.net, https://app.internationalmentorship.net

# Calendar & Payments Config (Simulated / Staging Keys)
NEXT_PUBLIC_CALENDAR_API_URL=https://app.internationalmentorship.net/api/calendar
NEXT_PUBLIC_ENABLE_MOCK_PAYMENTS=true

# Auth Configuration
NEXT_PUBLIC_AUTH_DOMAIN=app.internationalmentorship.net
